import AuditCP.Telescope

/-!
# Two-argument audit levels and exact change cocycles

This file gives an integrability criterion for an independently specified pairwise change law:
the law composes exactly along every triple of states if and only if it is the ordered difference
of a global potential.  Path sums of such a law depend only on their endpoints, so every closed
path nets exactly zero, and clipping the signed increments destroys that cancellation.

The results are algebraic.  They do not assert statistical propriety, audit blindness, interface
extensionality, or model-theoretic identification; those require further structure.
-/

namespace AuditCP

universe u v w

section ExactChange

/-- A two-argument audit level: the first coordinate is the target/benchmark and the second is the
quoted model state.

It is not called proper here: propriety requires a probabilistic specialization of `Target`,
`Quote`, and the level. -/
abbrev AuditLevel (Target : Type u) (Quote : Type v) (V : Type w) := Target → Quote → V

/-- The ordered change generated by a potential, with the Audit-CP sign convention
`before - after`. -/
def changeOfPotential {State : Type u} {V : Type v} [Sub V]
    (E : State → V) (before after : State) : V :=
  E before - E after

/-- A pairwise change law is an exact-comparison cocycle when adjacent changes compose to the
direct change on every triple.

It is stated independently of `changeOfPotential`; defining it by existence of a potential would
make the representation theorem below vacuous. -/
def IsChangeCocycle {State : Type u} {V : Type v} [Add V]
    (r : State → State → V) : Prop :=
  ∀ x y z, r x y + r y z = r x z

/-- Every potential difference is a change cocycle.

Proof anchor: Mathlib's axiom-clean `sub_add_sub_cancel`,
`Mathlib/Algebra/Group/Basic.lean:728`. -/
theorem changeOfPotential_isChangeCocycle {State : Type u} {V : Type v} [AddGroup V]
    (E : State → V) : IsChangeCocycle (changeOfPotential E) := by
  intro x y z
  exact sub_add_sub_cancel (E x) (E y) (E z)

/-- A change cocycle assigns zero change to every identity comparison. -/
theorem IsChangeCocycle.self_eq_zero {State : Type u} {V : Type v} [AddGroup V]
    {r : State → State → V} (hr : IsChangeCocycle r) (x : State) : r x x = 0 := by
  have h : r x x + r x x = r x x + 0 := by
    simpa using hr x x x
  exact add_left_cancel h

/-- A forward comparison followed by its reversal has zero total change. -/
theorem IsChangeCocycle.roundTrip_eq_zero {State : Type u} {V : Type v} [AddGroup V]
    {r : State → State → V} (hr : IsChangeCocycle r) (x y : State) :
    r x y + r y x = 0 := by
  simpa [hr.self_eq_zero] using hr x y x

/-- **Exact cocycle characterization.** On any complete comparison space, a pairwise
change law composes exactly iff it is the ordered difference of a global potential.

The forward direction handles the empty space directly and constructs the potential from a base
state otherwise; it is not a definition-unfold.  Its cancellation step uses Mathlib's axiom-clean
`eq_sub_of_add_eq`,
`Mathlib/Algebra/Group/Basic.lean:707`. -/
theorem isChangeCocycle_iff_exists_potential
    {State : Type u} {V : Type v} [AddGroup V]
    (r : State → State → V) :
    IsChangeCocycle r ↔ ∃ E : State → V, ∀ x y, r x y = changeOfPotential E x y := by
  constructor
  · intro hr
    classical
    rcases isEmpty_or_nonempty State with hEmpty | hNonempty
    · letI : IsEmpty State := hEmpty
      refine ⟨fun _ => 0, ?_⟩
      intro x
      exact isEmptyElim x
    · letI : Nonempty State := hNonempty
      let b : State := Classical.choice hNonempty
      refine ⟨fun x => r x b, ?_⟩
      intro x y
      exact eq_sub_of_add_eq (hr x y b)
  · rintro ⟨E, hE⟩
    intro x y z
    rw [hE x y, hE y z, hE x z]
    exact sub_add_sub_cancel (E x) (E y) (E z)

/-- Adding a common right-hand constant to a potential leaves every generated change unchanged.

Proof anchor: Mathlib's axiom-clean `add_sub_add_right_eq_sub`,
`Mathlib/Algebra/Group/Basic.lean:703`.  The side of the action matters because `V` need not be
commutative. -/
theorem changeOfPotential_add_right {State : Type u} {V : Type v} [AddGroup V]
    (E : State → V) (c : V) (x y : State) :
    changeOfPotential (fun z => E z + c) x y = changeOfPotential E x y := by
  exact add_sub_add_right_eq_sub (E x) (E y) c

/-- **Potential uniqueness modulo gauge.** If two potentials generate the same complete
pairwise change law, then one is the other plus a single right-additive constant.

The empty state space is handled without adding a nonemptiness premise.  In the nonempty case the
rearrangement uses Mathlib's `sub_eq_iff_eq_add`,
`Mathlib/Algebra/Group/Basic.lean:762`. -/
theorem exists_eq_add_right_of_changeOfPotential_eq
    {State : Type u} {V : Type v} [AddGroup V]
    (E F : State → V)
    (hEF : ∀ x y, changeOfPotential E x y = changeOfPotential F x y) :
    ∃ c : V, ∀ x, E x = F x + c := by
  classical
  rcases isEmpty_or_nonempty State with hEmpty | hNonempty
  · letI : IsEmpty State := hEmpty
    refine ⟨0, ?_⟩
    intro x
    exact isEmptyElim x
  · letI : Nonempty State := hNonempty
    let b : State := Classical.choice hNonempty
    refine ⟨-F b + E b, ?_⟩
    intro x
    have hx : E x - E b = F x - F b := hEF x b
    have hx' : E x = (F x - F b) + E b := (sub_eq_iff_eq_add).mp hx
    simpa [sub_eq_add_neg, add_assoc] using hx'

/-- Sum a pairwise change law along the first `T` edges of a trajectory.

`Finset.sum` deliberately exposes the commutative finite-ledger requirement. -/
def pathChange {State : Type u} {V : Type v} [AddCommMonoid V]
    (r : State → State → V) (g : ℕ → State) (T : ℕ) : V :=
  ∑ t ∈ Finset.range T, r (g t) (g (t + 1))

/-- A potential-generated path sum is exactly its endpoint difference.

Proof anchor: Mathlib's axiom-clean `Finset.sum_range_sub'`,
`Mathlib/Algebra/BigOperators/Group/Finset/Basic.lean:899`. -/
theorem pathChange_changeOfPotential {State : Type u} {V : Type v} [AddCommGroup V]
    (E : State → V) (g : ℕ → State) (T : ℕ) :
    pathChange (changeOfPotential E) g T = changeOfPotential E (g 0) (g T) := by
  simpa [pathChange, changeOfPotential] using
    (Finset.sum_range_sub' (fun t => E (g t)) T)

/-- **Cocycle path invariance.** The total of any finite cocycle path is its direct endpoint
change.  Unlike the telescope theorem, the edge law here is supplied independently and integrated
only through `isChangeCocycle_iff_exists_potential`. -/
theorem IsChangeCocycle.pathChange_eq {State : Type u} {V : Type v} [AddCommGroup V]
    {r : State → State → V} (hr : IsChangeCocycle r) (g : ℕ → State) (T : ℕ) :
    pathChange r g T = r (g 0) (g T) := by
  obtain ⟨E, hE⟩ := (isChangeCocycle_iff_exists_potential r).mp hr
  calc
    pathChange r g T = pathChange (changeOfPotential E) g T := by
      apply Finset.sum_congr rfl
      intro t _ht
      exact hE (g t) (g (t + 1))
    _ = changeOfPotential E (g 0) (g T) := pathChange_changeOfPotential E g T
    _ = r (g 0) (g T) := (hE (g 0) (g T)).symm

/-- Two cocycle paths with the same endpoints have the same total, irrespective of their lengths
or intermediate states. -/
theorem IsChangeCocycle.path_independent {State : Type u} {V : Type v} [AddCommGroup V]
    {r : State → State → V} (hr : IsChangeCocycle r)
    (g h : ℕ → State) (T U : ℕ) (hstart : g 0 = h 0) (hend : g T = h U) :
    pathChange r g T = pathChange r h U := by
  rw [hr.pathChange_eq, hr.pathChange_eq, hstart, hend]

/-- Every closed cocycle path has exactly zero total change. -/
theorem IsChangeCocycle.closed_path_eq_zero {State : Type u} {V : Type v} [AddCommGroup V]
    {r : State → State → V} (hr : IsChangeCocycle r)
    (g : ℕ → State) (T : ℕ) (hclosed : g T = g 0) :
    pathChange r g T = 0 := by
  rw [hr.pathChange_eq, hclosed, hr.self_eq_zero]

/-- Clipping signed increments destroys loop cancellation: the potential loop
`0 → -1 → 0` has signed total zero but clipped total one. -/
theorem clipped_change_closed_loop_counterexample :
    ∃ (E : Bool → ℝ) (g : ℕ → Bool),
      g 0 = g 2 ∧
      pathChange (changeOfPotential E) g 2 = 0 ∧
      (∑ t ∈ Finset.range 2, max 0 (changeOfPotential E (g t) (g (t + 1)))) = 1 := by
  refine ⟨(fun b => if b then -1 else 0),
    (fun t => if t = 1 then true else false), ?_⟩
  norm_num [pathChange, changeOfPotential, Finset.sum_range_succ]

end ExactChange

section TwoArgumentLevel

variable {Target : Type u} {Quote : Type v} {V : Type w}

/-- Model progress is the target-fixed chart of a two-argument audit level.

The sign is `before - after`. -/
def modelProgress [Sub V] (L : AuditLevel Target Quote V)
    (q : Target) (pBefore pAfter : Quote) : V :=
  L q pBefore - L q pAfter

/-- Benchmark drift is the quote-fixed chart of a two-argument audit level.

Positive drift means the old target assigned the fixed quote a higher level than the new
target. -/
def benchmarkDrift [Sub V] (L : AuditLevel Target Quote V)
    (p : Quote) (qBefore qAfter : Target) : V :=
  L qBefore p - L qAfter p

/-- The raw endpoint contrast when both target and quote move.  It is intentionally not identified
as model progress or benchmark drift until one of the bridge theorems splits it. -/
def jointAuditChange [Sub V] (L : AuditLevel Target Quote V)
    (qBefore qAfter : Target) (pBefore pAfter : Quote) : V :=
  L qBefore pBefore - L qAfter pAfter

/-- Recalibrate each target by a target-dependent right-additive baseline.

The gauge action remains explicit rather than quotiented because model progress and benchmark
drift have different invariance groups. -/
def shiftAuditLevel [Add V] (L : AuditLevel Target Quote V) (c : Target → V) :
    AuditLevel Target Quote V :=
  fun q p => L q p + c q

/-- **Model-progress gauge invariance.** Every target may be assigned its own baseline
without changing any comparison made at that fixed target.

Proof anchor: Mathlib's `add_sub_add_right_eq_sub`,
`Mathlib/Algebra/Group/Basic.lean:703`. -/
theorem modelProgress_shiftAuditLevel [AddGroup V]
    (L : AuditLevel Target Quote V) (c : Target → V)
    (q : Target) (p₀ p₁ : Quote) :
    modelProgress (shiftAuditLevel L c) q p₀ p₁ = modelProgress L q p₀ p₁ := by
  exact add_sub_add_right_eq_sub (L q p₀) (L q p₁) (c q)

/-- **Benchmark-drift gauge defect.** Under target-dependent recalibration, benchmark
drift changes by exactly the difference between the two target baselines.  Consequently drift is
not defined on the larger target-local gauge quotient on which model progress is defined. -/
theorem benchmarkDrift_shiftAuditLevel [AddCommGroup V]
    (L : AuditLevel Target Quote V) (c : Target → V)
    (p : Quote) (q₀ q₁ : Target) :
    benchmarkDrift (shiftAuditLevel L c) p q₀ q₁ =
      benchmarkDrift L p q₀ q₁ + (c q₀ - c q₁) := by
  simp [benchmarkDrift, shiftAuditLevel]
  abel

/-- Equal calibration at the compared targets is sufficient for benchmark drift to be invariant. -/
theorem benchmarkDrift_shiftAuditLevel_of_eq [AddCommGroup V]
    (L : AuditLevel Target Quote V) (c : Target → V)
    (p : Quote) (q₀ q₁ : Target) (hc : c q₀ = c q₁) :
    benchmarkDrift (shiftAuditLevel L c) p q₀ q₁ = benchmarkDrift L p q₀ q₁ := by
  rw [benchmarkDrift_shiftAuditLevel, hc, sub_self, add_zero]

/-- **Bridge at the final quote.** One cross-evaluation splits a both-moving contrast into
model progress at the old target plus benchmark drift at the final quote.

Proof anchor: Mathlib's `sub_add_sub_cancel`,
`Mathlib/Algebra/Group/Basic.lean:728`. -/
theorem jointAuditChange_eq_modelProgress_add_benchmarkDrift [AddGroup V]
    (L : AuditLevel Target Quote V) (q₀ q₁ : Target) (p₀ p₁ : Quote) :
    jointAuditChange L q₀ q₁ p₀ p₁ =
      modelProgress L q₀ p₀ p₁ + benchmarkDrift L p₁ q₀ q₁ := by
  exact (sub_add_sub_cancel (L q₀ p₀) (L q₀ p₁) (L q₁ p₁)).symm

/-- **Bridge at the initial quote.** The same contrast can instead be split into benchmark
drift at the initial quote plus model progress at the new target. -/
theorem jointAuditChange_eq_benchmarkDrift_add_modelProgress [AddGroup V]
    (L : AuditLevel Target Quote V) (q₀ q₁ : Target) (p₀ p₁ : Quote) :
    jointAuditChange L q₀ q₁ p₀ p₁ =
      benchmarkDrift L p₀ q₀ q₁ + modelProgress L q₁ p₀ p₁ := by
  exact (sub_add_sub_cancel (L q₀ p₀) (L q₁ p₀) (L q₁ p₁)).symm

/-- **Target/quote rectangle identity.** The target-sensitivity of measured model progress
equals the quote-sensitivity of measured benchmark drift.

Proof anchor: Mathlib's `sub_sub_sub_comm`,
`Mathlib/Algebra/Group/Basic.lean:574`. -/
theorem modelProgress_sub_modelProgress_eq_benchmarkDrift_sub_benchmarkDrift
    [AddCommGroup V]
    (L : AuditLevel Target Quote V) (q₀ q₁ : Target) (p₀ p₁ : Quote) :
    modelProgress L q₀ p₀ p₁ - modelProgress L q₁ p₀ p₁ =
      benchmarkDrift L p₀ q₀ q₁ - benchmarkDrift L p₁ q₀ q₁ := by
  exact sub_sub_sub_comm (L q₀ p₀) (L q₀ p₁) (L q₁ p₀) (L q₁ p₁)

/-- **Dynamic target-drift decomposition.** Across `T+1` quote transitions scored at targets
`q 1, …, q (T+1)`, total fixed-target model progress is the cross-target endpoint contrast plus
exactly `T` fixed-quote benchmark-drift bridges.

The drift orientation is new-target minus old-target, represented as
`benchmarkDrift L p (qNew) (qOld)`. -/
theorem sum_modelProgress_eq_endpoint_add_benchmarkDrift [AddCommGroup V]
    (L : AuditLevel Target Quote V) (q : ℕ → Target) (p : ℕ → Quote) (T : ℕ) :
    (∑ t ∈ Finset.range (T + 1), modelProgress L (q (t + 1)) (p t) (p (t + 1))) =
      jointAuditChange L (q 1) (q (T + 1)) (p 0) (p (T + 1)) +
        ∑ t ∈ Finset.range T, benchmarkDrift L (p (t + 1)) (q (t + 2)) (q (t + 1)) := by
  induction T with
  | zero =>
      simp [modelProgress, benchmarkDrift, jointAuditChange]
  | succ T ih =>
      rw [Finset.sum_range_succ]
      rw [ih]
      rw [Finset.sum_range_succ]
      simp [modelProgress, benchmarkDrift, jointAuditChange]
      abel

end TwoArgumentLevel

end AuditCP

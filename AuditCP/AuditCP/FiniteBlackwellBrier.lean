import AuditCP.LawBridge

/-!
# Chapter 10 — a scoring rule sees row equality, if the prior has full support

Chapter 8 characterizes row equality prior-free; Chapter 9 characterizes it by binary decisions.
This chapter characterizes it by a single proper scoring rule against a single fixed prior, and
records what that costs: full support.  Without it, prior-null rows are unconstrained and the
characterization fails.

For a categorical distribution, the reduction in optimal Brier risk after observing the output is
the expected squared Euclidean displacement of the posterior from the prior.  See Brier,
"Verification of Forecasts Expressed in Terms of Probability", *Monthly Weather Review* 78(1),
1950, 1--3.  The theorem below formalizes that posterior-displacement expression and its exact zero
set.

**Carrier warning.**  Every row family here has type `A → FinitePMF Y`: a reading of a B1 carrier
into the simplex-constrained refinement of B2 `AuditPotential`.  It is *not* a B6 `AuditChannel`.
There is no permitted public coordinate, no protected coordinate, and no `AuditSealed` hypothesis
anywhere in this file, and the closure supplies no map between the two carriers.  Read the results
as what they say: statements about equality of the rows of a finite row family.
-/

namespace AuditCP

universe uS uA uY

open Finset

/-- If two finite pmfs on `A` have equal `prob` functions, they are equal. -/
theorem finitePMF_ext {A : Type uA} [Fintype A] {p q : FinitePMF A}
    (h : p.prob = q.prob) : p = q := by
  cases p with
  | mk pp hp0 hp1 =>
      cases q with
      | mk qp hq0 hq1 =>
          simp only at h
          subst qp
          rfl

/-- The output marginal at `y` generated by prior `q` and row family `K`,
`∑ a, q.prob a * (K a).prob y`. -/
noncomputable def finiteOutputMarginal
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) (y : Y) : ℝ :=
  ∑ a, q.prob a * (K a).prob y

/-- `0 ≤ finiteOutputMarginal q K y`. -/
theorem finiteOutputMarginal_nonneg
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) (y : Y) :
    0 ≤ finiteOutputMarginal q K y := by
  unfold finiteOutputMarginal
  exact Finset.sum_nonneg fun a _ => mul_nonneg (q.prob_nonneg a) ((K a).prob_nonneg y)

/-- `∑ y, finiteOutputMarginal q K y = 1`. -/
theorem sum_finiteOutputMarginal_eq_one
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) :
    ∑ y, finiteOutputMarginal q K y = 1 := by
  unfold finiteOutputMarginal
  rw [Finset.sum_comm]
  simp_rw [← Finset.mul_sum, (K _).prob_sum_one, mul_one]
  exact q.prob_sum_one

/-- The posterior mass on `a` after output `y`, `q.prob a * (K a).prob y / finiteOutputMarginal q K y`,
or `q.prob a` where the output marginal is `0`. -/
noncomputable def finitePosteriorMass
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) (y : Y) (a : A) : ℝ :=
  if finiteOutputMarginal q K y = 0 then q.prob a
  else q.prob a * (K a).prob y / finiteOutputMarginal q K y

/-- `0 ≤ finitePosteriorMass q K y a`. -/
theorem finitePosteriorMass_nonneg
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) (y : Y) (a : A) :
    0 ≤ finitePosteriorMass q K y a := by
  unfold finitePosteriorMass
  split_ifs with _hzero
  · exact q.prob_nonneg a
  · exact div_nonneg (mul_nonneg (q.prob_nonneg a) ((K a).prob_nonneg y))
      (finiteOutputMarginal_nonneg q K y)

/-- `∑ a, finitePosteriorMass q K y a = 1`. -/
theorem sum_finitePosteriorMass_eq_one
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) (y : Y) :
    ∑ a, finitePosteriorMass q K y a = 1 := by
  unfold finitePosteriorMass
  split_ifs with hzero
  · exact q.prob_sum_one
  · rw [← Finset.sum_div]
    change finiteOutputMarginal q K y / finiteOutputMarginal q K y = 1
    exact div_self hzero

/-- The posterior after output `y` packaged as a finite pmf, with
`prob := finitePosteriorMass q K y`. -/
noncomputable def finitePosterior
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) (y : Y) : FinitePMF A where
  prob := finitePosteriorMass q K y
  prob_nonneg := finitePosteriorMass_nonneg q K y
  prob_sum_one := sum_finitePosteriorMass_eq_one q K y

/-- The categorical Brier loss of `forecast` at outcome `actual`,
`(∑ b, forecast.prob b ^ 2) - 2 * forecast.prob actual + 1` (brier1950). -/
noncomputable def finiteBrierLoss
    {A : Type uA} [Fintype A] (forecast : FinitePMF A) (actual : A) : ℝ :=
  (∑ b, forecast.prob b ^ 2) - 2 * forecast.prob actual + 1

/-- `finiteBrierLoss forecast actual = ∑ b, ((if b = actual then 1 else 0) - forecast.prob b) ^ 2`. -/
theorem finiteBrierLoss_eq_indicatorSquares
    {A : Type uA} [Fintype A] [DecidableEq A]
    (forecast : FinitePMF A) (actual : A) :
    finiteBrierLoss forecast actual =
      ∑ b, ((if b = actual then 1 else 0) - forecast.prob b) ^ 2 := by
  unfold finiteBrierLoss
  symm
  calc
    _ = ∑ b, (forecast.prob b ^ 2 -
        2 * forecast.prob b * (if b = actual then 1 else 0) +
        (if b = actual then 1 else 0)) := by
          apply Finset.sum_congr rfl
          intro b _hb
          split_ifs <;> ring
    _ = _ := by
      rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
      simp

/-- The expected Brier loss when `truth` generates the outcome and `forecast` is reported,
`∑ a, truth.prob a * finiteBrierLoss forecast a` (brier1950). -/
noncomputable def finiteExpectedBrier
    {A : Type uA} [Fintype A] (truth forecast : FinitePMF A) : ℝ :=
  ∑ a, truth.prob a * finiteBrierLoss forecast a

/-- `finiteExpectedBrier truth forecast = finiteExpectedBrier truth truth +
∑ a, (forecast.prob a - truth.prob a) ^ 2` (gneiting2007). -/
theorem finiteExpectedBrier_decomposition
    {A : Type uA} [Fintype A] (truth forecast : FinitePMF A) :
    finiteExpectedBrier truth forecast =
      finiteExpectedBrier truth truth + ∑ a, (forecast.prob a - truth.prob a) ^ 2 := by
  unfold finiteExpectedBrier finiteBrierLoss
  rw [show (∑ a, truth.prob a * ((∑ b, forecast.prob b ^ 2) -
      2 * forecast.prob a + 1)) =
      (∑ b, forecast.prob b ^ 2) - 2 * ∑ a, truth.prob a * forecast.prob a + 1 by
    calc
      _ = ∑ a, (truth.prob a * (∑ b, forecast.prob b ^ 2) -
          2 * (truth.prob a * forecast.prob a) + truth.prob a) := by
            apply Finset.sum_congr rfl
            intro a _ha
            ring
      _ = (∑ a, truth.prob a) * (∑ b, forecast.prob b ^ 2) -
          2 * ∑ a, truth.prob a * forecast.prob a + ∑ a, truth.prob a := by
            rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
            rw [← Finset.sum_mul, ← Finset.mul_sum]
      _ = _ := by rw [truth.prob_sum_one]; ring]
  rw [show (∑ a, truth.prob a * ((∑ b, truth.prob b ^ 2) -
      2 * truth.prob a + 1)) = 1 - ∑ a, truth.prob a ^ 2 by
    calc
      _ = ∑ a, (truth.prob a * (∑ b, truth.prob b ^ 2) -
          2 * truth.prob a ^ 2 + truth.prob a) := by
            apply Finset.sum_congr rfl
            intro a _ha
            ring
      _ = (∑ a, truth.prob a) * (∑ b, truth.prob b ^ 2) -
          2 * ∑ a, truth.prob a ^ 2 + ∑ a, truth.prob a := by
            rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
            rw [← Finset.sum_mul, ← Finset.mul_sum]
      _ = _ := by rw [truth.prob_sum_one]; ring]
  rw [show (∑ a, (forecast.prob a - truth.prob a) ^ 2) =
      (∑ a, forecast.prob a ^ 2) - 2 * ∑ a, truth.prob a * forecast.prob a +
        ∑ a, truth.prob a ^ 2 by
    simp_rw [sub_sq]
    calc
      _ = ∑ a, (forecast.prob a ^ 2 -
          2 * (truth.prob a * forecast.prob a) + truth.prob a ^ 2) := by
            apply Finset.sum_congr rfl
            intro a _ha
            ring
      _ = _ := by
        rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]]
  ring

/-- The expected squared posterior displacement from the prior,
`∑ y, finiteOutputMarginal q K y * ∑ a, (finitePosteriorMass q K y a - q.prob a) ^ 2`. -/
noncomputable def finiteBrierPosteriorGain
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) : ℝ :=
  ∑ y, finiteOutputMarginal q K y *
    ∑ a, (finitePosteriorMass q K y a - q.prob a) ^ 2

/-- `0 ≤ finiteBrierPosteriorGain q K`. -/
theorem finiteBrierPosteriorGain_nonneg
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) :
    0 ≤ finiteBrierPosteriorGain q K := by
  unfold finiteBrierPosteriorGain
  apply Finset.sum_nonneg
  intro y _hy
  exact mul_nonneg (finiteOutputMarginal_nonneg q K y)
    (Finset.sum_nonneg fun a _ => sq_nonneg _)

/-- `finiteOutputMarginal q K y * finitePosteriorMass q K y a = q.prob a * (K a).prob y`. -/
theorem finiteOutputMarginal_mul_finitePosteriorMass
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) (y : Y) (a : A) :
    finiteOutputMarginal q K y * finitePosteriorMass q K y a =
      q.prob a * (K a).prob y := by
  by_cases hm : finiteOutputMarginal q K y = 0
  · rw [hm, zero_mul]
    have hweighted : (fun b ↦ q.prob b * (K b).prob y) = 0 := by
      apply (Fintype.sum_eq_zero_iff_of_nonneg fun b ↦
        mul_nonneg (q.prob_nonneg b) ((K b).prob_nonneg y)).1
      exact hm
    exact (congrFun hweighted a).symm
  · rw [finitePosteriorMass, if_neg hm]
    field_simp

/-- `∑ y, finiteOutputMarginal q K y * finitePosteriorMass q K y a = q.prob a`. -/
theorem finitePosterior_barycenter
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) (a : A) :
    ∑ y, finiteOutputMarginal q K y * finitePosteriorMass q K y a = q.prob a := by
  calc
    _ = ∑ y, q.prob a * (K a).prob y := by
      apply Finset.sum_congr rfl
      intro y _hy
      exact finiteOutputMarginal_mul_finitePosteriorMass q K y a
    _ = q.prob a * ∑ y, (K a).prob y := by rw [Finset.mul_sum]
    _ = q.prob a := by rw [(K a).prob_sum_one, mul_one]

/-- The optimal expected Brier risk after observing the output and reporting the posterior,
`∑ y, finiteOutputMarginal q K y * finiteExpectedBrier (finitePosterior q K y) (finitePosterior q K y)`. -/
noncomputable def finitePosteriorBrierRisk
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) : ℝ :=
  ∑ y, finiteOutputMarginal q K y *
    finiteExpectedBrier (finitePosterior q K y) (finitePosterior q K y)

/-- F4 — `finiteExpectedBrier q q - finitePosteriorBrierRisk q K = finiteBrierPosteriorGain q K`. -/
theorem finiteBrierRisk_reduction_eq_posteriorGain
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y) :
    finiteExpectedBrier q q - finitePosteriorBrierRisk q K =
      finiteBrierPosteriorGain q K := by
  have havg :
      (∑ y, finiteOutputMarginal q K y *
        finiteExpectedBrier (finitePosterior q K y) q) = finiteExpectedBrier q q := by
    unfold finiteExpectedBrier
    calc
      _ = ∑ y, ∑ a, (finiteOutputMarginal q K y *
          finitePosteriorMass q K y a) * finiteBrierLoss q a := by
            apply Finset.sum_congr rfl
            intro y _hy
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro a _ha
            simp only [finitePosterior]
            ring
      _ = ∑ a, ∑ y, (finiteOutputMarginal q K y *
          finitePosteriorMass q K y a) * finiteBrierLoss q a := Finset.sum_comm
      _ = ∑ a, (∑ y, finiteOutputMarginal q K y *
          finitePosteriorMass q K y a) * finiteBrierLoss q a := by
            apply Finset.sum_congr rfl
            intro a _ha
            rw [Finset.sum_mul]
      _ = _ := by
        apply Finset.sum_congr rfl
        intro a _ha
        rw [finitePosterior_barycenter q K a]
  have hdecomp : ∀ y,
      finiteExpectedBrier (finitePosterior q K y) q =
        finiteExpectedBrier (finitePosterior q K y) (finitePosterior q K y) +
          ∑ a, (finitePosteriorMass q K y a - q.prob a) ^ 2 := by
    intro y
    rw [finiteExpectedBrier_decomposition]
    simp only [finitePosterior]
    congr 1
    apply Finset.sum_congr rfl
    intro a _ha
    ring
  rw [← havg]
  unfold finitePosteriorBrierRisk finiteBrierPosteriorGain
  calc
    _ = ∑ y, finiteOutputMarginal q K y *
        (finiteExpectedBrier (finitePosterior q K y) q -
          finiteExpectedBrier (finitePosterior q K y) (finitePosterior q K y)) := by
            rw [← Finset.sum_sub_distrib]
            apply Finset.sum_congr rfl
            intro y _hy
            ring
    _ = _ := by
      apply Finset.sum_congr rfl
      intro y _hy
      rw [hdecomp]
      ring

/-- If `q` has full support and `finiteBrierPosteriorGain q K = 0`, then every row of `K` equals
the output marginal: `∀ a y, (K a).prob y = finiteOutputMarginal q K y`. -/
theorem rows_eq_marginal_of_brierGain_eq_zero
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (hq : ∀ a, 0 < q.prob a)
    (K : A → FinitePMF Y) (hgain : finiteBrierPosteriorGain q K = 0) :
    ∀ a y, (K a).prob y = finiteOutputMarginal q K y := by
  have houter :
      (fun y => finiteOutputMarginal q K y *
        ∑ a, (finitePosteriorMass q K y a - q.prob a) ^ 2) = (0 : Y → ℝ) := by
    apply (Fintype.sum_eq_zero_iff_of_nonneg fun y =>
      mul_nonneg (finiteOutputMarginal_nonneg q K y)
        (Finset.sum_nonneg fun a _ => sq_nonneg _)).1
    exact hgain
  intro a y
  by_cases hm : finiteOutputMarginal q K y = 0
  · have hweighted :
        (fun b => q.prob b * (K b).prob y) = 0 := by
      apply (Fintype.sum_eq_zero_iff_of_nonneg fun b =>
        mul_nonneg (q.prob_nonneg b) ((K b).prob_nonneg y)).1
      exact hm
    have ha := congrFun hweighted a
    have hKa : (K a).prob y = 0 :=
      (mul_eq_zero.1 ha).resolve_left (ne_of_gt (hq a))
    exact hKa.trans hm.symm
  · have hinner : ∑ b, (finitePosteriorMass q K y b - q.prob b) ^ 2 = 0 := by
      have hy := congrFun houter y
      exact (mul_eq_zero.1 hy).resolve_left hm
    have hpoint :
        (fun b => (finitePosteriorMass q K y b - q.prob b) ^ 2) = 0 :=
      (Fintype.sum_eq_zero_iff_of_nonneg fun b => sq_nonneg _).1 hinner
    have hposterior : finitePosteriorMass q K y a = q.prob a := by
      have ha := congrFun hpoint a
      exact sub_eq_zero.1 (sq_eq_zero_iff.1 ha)
    rw [finitePosteriorMass, if_neg hm] at hposterior
    have hmul : q.prob a * (K a).prob y =
        q.prob a * finiteOutputMarginal q K y :=
      (div_eq_iff hm).1 hposterior
    exact (mul_left_cancel₀ (ne_of_gt (hq a)) hmul)

/-- If all rows of `K` are equal, then `finiteOutputMarginal q K y = (K a₀).prob y` for every
`a₀`. -/
theorem finiteOutputMarginal_eq_of_rowsEqual
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y]
    (q : FinitePMF A) (K : A → FinitePMF Y)
    (hrows : ∀ a a', K a = K a') (a₀ : A) (y : Y) :
    finiteOutputMarginal q K y = (K a₀).prob y := by
  unfold finiteOutputMarginal
  calc
    (∑ a, q.prob a * (K a).prob y) = ∑ a, q.prob a * (K a₀).prob y := by
      apply Finset.sum_congr rfl
      intro a _ha
      rw [hrows a a₀]
    _ = (∑ a, q.prob a) * (K a₀).prob y := by rw [Finset.sum_mul]
    _ = (K a₀).prob y := by rw [q.prob_sum_one, one_mul]

/-- Given `A` nonempty and `q` full support, `finiteBrierPosteriorGain q K = 0 ↔
∀ a a', K a = K a'`. -/
theorem finiteBrierPosteriorGain_eq_zero_iff_rowsEqual
    {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y] [Nonempty A]
    (q : FinitePMF A) (hq : ∀ a, 0 < q.prob a) (K : A → FinitePMF Y) :
    finiteBrierPosteriorGain q K = 0 ↔ ∀ a a', K a = K a' := by
  constructor
  · intro hgain a a'
    apply finitePMF_ext
    funext y
    exact (rows_eq_marginal_of_brierGain_eq_zero q hq K hgain a y).trans
      (rows_eq_marginal_of_brierGain_eq_zero q hq K hgain a' y).symm
  · intro hrows
    let a₀ : A := Classical.choice inferInstance
    unfold finiteBrierPosteriorGain
    apply Finset.sum_eq_zero
    intro y _hy
    have hmarg : finiteOutputMarginal q K y = (K a₀).prob y :=
      finiteOutputMarginal_eq_of_rowsEqual q K hrows a₀ y
    by_cases hm : finiteOutputMarginal q K y = 0
    · rw [hm, zero_mul]
    · have hposterior : ∀ a, finitePosteriorMass q K y a = q.prob a := by
        intro a
        rw [finitePosteriorMass, if_neg hm, hrows a a₀, ← hmarg]
        rw [mul_comm]
        exact mul_div_cancel_left₀ (q.prob a) hm
      simp [hposterior]

/-- F4 — given `A` nonempty and `q` full support,
`(∀ s, finiteBrierPosteriorGain q (fun a => finitePMFOfPMF (K (s, a))) = 0) ↔ AuditSealed K`. -/
theorem finiteBrierPosteriorGain_eq_zero_iff_auditSealed
    {S : Type uS} {A : Type uA} {Y : Type uY} [Fintype A] [Fintype Y] [Nonempty A]
    (q : FinitePMF A) (hq : ∀ a, 0 < q.prob a) (K : AuditChannel S A Y) :
    (∀ s, finiteBrierPosteriorGain q (fun a => finitePMFOfPMF (K (s, a))) = 0) ↔
      AuditSealed K := by
  have hinj : Function.Injective (finitePMFOfPMF (H := Y)) :=
    Function.LeftInverse.injective (g := FinitePMF.toPMF) toPMF_finitePMFOfPMF
  constructor
  · intro hgain s a a'
    exact hinj ((finiteBrierPosteriorGain_eq_zero_iff_rowsEqual q hq
      (fun a => finitePMFOfPMF (K (s, a)))).1 (hgain s) a a')
  · intro hsealed s
    exact (finiteBrierPosteriorGain_eq_zero_iff_rowsEqual q hq
      (fun a => finitePMFOfPMF (K (s, a)))).2
      fun a a' => congrArg finitePMFOfPMF (hsealed s a a')

end AuditCP
